# Copia este archivo a .env.local (local) o pon estas variables en Vercel › Settings › Environment Variables.
# Nunca subas valores reales al repositorio.

# Proyecto de Supabase «bufetea» (Project Settings › API). Son públicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la app (la de Vercel mientras no haya dominio). Se usa en los enlaces de los correos.
NEXT_PUBLIC_APP_URL=

# Dominio de Bufetea. Mientras esté vacío, el buzón de entrada, el remitente y el portal se muestran como «pendiente de dominio».
NEXT_PUBLIC_BUFETEA_DOMINIO=

# Modo demostración con datos ficticios (1 = sin Supabase). Se activa solo si faltan las variables de Supabase.
NEXT_PUBLIC_BUFETEA_DEMO=
